{
  "name": "dls-magician-cloud",
  "version": "1.0.0",
  "private": true,
  "description": "A runnable cloud-collaboration MVP for DLS Magician.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mcp:setup": "npm ci --prefix mcp",
    "mcp": "node mcp/server.mjs",
    "test:mcp": "npm test --prefix mcp",
    "demo:mcp": "npm run demo --prefix mcp",
    "package:mcp": "npm pack ./mcp",
    "showcase:mcp": "node mcp/build-showcase.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
